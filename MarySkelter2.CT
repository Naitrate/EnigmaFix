            <CheatEntry>
              <ID>59</ID>
              <Description>"Fixes"</Description>
              <Options moManualExpandCollapse="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>287</ID>
                  <Description>"Animation Fixes"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//==============================================================================
// Mary Skelter 2 (PC, v1.01) - Framerate-Independent Animation Fix
// Engine: "prophet" (Compile Heart / Idea Factory in-house)
// Requires: the framerate cap to already be disabled.
//==============================================================================
//
// WHY ANIMATIONS RUN FAST AFTER UNLOCKING THE FRAMERATE
// -----------------------------------------------------
// 1) Framework_GetDeltaTime()          MarySkelter2.exe+14D790
//      return g_Framework-&gt;deltaTime;  // field +0x128
//    That field is a HARDCODED 1/60 (0.0166666754). It is never updated from
//    real elapsed time. Every 2D tween in the engine does:
//        tween.time += Framework_GetDeltaTime();
//        value       = Tween_Evaluate(tween);
//    so at N fps every 2D/UI/VN animation plays at N/60 speed.
//
// 2) The engine ALREADY measures a real per-frame delta and stores it at
//      MarySkelter2.exe+136565C   (float, seconds)   -&gt; g_realFrameDelta
//    and a smoothed framerate at
//      [[MarySkelter2.exe+A6A3A8]+0xC0]  (float, fps)
//
// 3) GetFrameStepScale()               MarySkelter2.exe+1391C0
//      return max(60.0f / measuredFps, 1.0f);
//    This is the engine's own compensation for frame-COUNT based animations
//    (used by 8 callers). It works going down (30fps -&gt; 2.0) but the maxss
//    floor of 1.0 means it can never scale below 60fps. Above 60 it is stuck
//    at 1.0 and those animations run fast.
//
// 4) UpdateFrameCounterTween()         MarySkelter2.exe+10D980
//      obj-&gt;frame += 1.0f;  ratio = obj-&gt;frame / (float)obj-&gt;durationInFrames;
//    Both branches (+10D9A5 and +10D9B5) add a literal 1.0 per update.
//
// WHAT THIS SCRIPT DOES
// ---------------------
//  * Framework_GetDeltaTime -&gt; returns the real measured delta (clamped to
//    1/30 max so a hitch can't make animations jump).
//  * Maintains g_frameScale = realDelta * 60  (= "frames elapsed this update",
//    1.0 at 60fps, 0.5 at 120fps, 2.0 at 30fps), clamped to [0.02, 2.0].
//  * GetFrameStepScale -&gt; returns g_frameScale, removing the 1.0 floor.
//  * Both +=1.0 sites in UpdateFrameCounterTween -&gt; += g_frameScale.
//
// REPLACES (disable these first, they conflict / fight each other):
//  - "WIP Character Bustup and Other Animation Speed Fix"   (+119493, +10D9B5)
//        +119493 was wrong: that 1.0 is an identity/clamp constant inside the
//        bone transform routine, not an animation step.
//  - "Some sort of animation speed?"          (+1391D7 maxss floor)
//  - "Fix Some Particle Animation Speed"      (+14D790)
//  - "Potential Slowdown Fix?"                (+125FDB)
//  - the two unnamed Auto Assemble scripts    (+98422 +9AE82 +A0291 +CBB3A +CBB6A)
//        THESE WERE THE MAIN CULPRIT: they replaced `call GetDeltaTime` with a
//        hardcoded 1/60 inside UpdateTweenList_A/B/C and UpdateBustupBlinkState,
//        i.e. exactly the 2D + VN animation updaters.
//
// g_frameScale is exported as a CE symbol - you can add it to the table as a
// Float to watch it live (should read ~60/your_fps).
//==============================================================================

[ENABLE]
alloc(fpsfix,512,"MarySkelter2.exe")
label(g_frameScale)
label(c_scaleMin)
label(c_scaleMax)
label(c_deltaMax)
label(GetDeltaTime_new)
label(GetFrameStep_new)
registersymbol(fpsfix)
registersymbol(g_frameScale)

fpsfix:
g_frameScale:
 dd (float)1.0
c_scaleMin:
 dd (float)0.02
c_scaleMax:
 dd (float)2.0
c_deltaMax:
 dd (float)0.0333333

// Framework_GetDeltaTime -&gt; real delta; also refresh g_frameScale
GetDeltaTime_new:
 movss xmm0,[MarySkelter2.exe+700DC4]     // 60.0
 mulss xmm0,[MarySkelter2.exe+136565C]    // 60 * realDelta
 maxss xmm0,[c_scaleMin]
 minss xmm0,[c_scaleMax]
 movss [g_frameScale],xmm0
 movss xmm0,[MarySkelter2.exe+136565C]
 minss xmm0,[c_deltaMax]
 ret

// GetFrameStepScale -&gt; frames elapsed this update, no 1.0 floor
GetFrameStep_new:
 movss xmm0,[g_frameScale]
 ret

"MarySkelter2.exe"+14D790:
 jmp GetDeltaTime_new

"MarySkelter2.exe"+1391C0:
 jmp GetFrameStep_new

"MarySkelter2.exe"+10D9A5:
 movss xmm6,[g_frameScale]

"MarySkelter2.exe"+10D9B5:
 addss xmm4,[g_frameScale]

[DISABLE]
"MarySkelter2.exe"+14D790:
 db 48 8B 05 61 F7 91 00 F3 0F 10 80 28 01 00 00 C3

"MarySkelter2.exe"+1391C0:
 db 48 8B 05 E1 11 93 00 F3 0F 10 05 F5 7B 5C 00 F3 0F 5E 80 C0 00 00 00 F3 0F 5F 05 A9 63 5C 00 C3

"MarySkelter2.exe"+10D9A5:
 db F3 0F 10 35 DB 1B 5F 00

"MarySkelter2.exe"+10D9B5:
 db F3 0F 58 25 3B 8A BF 00

unregistersymbol(g_frameScale)
unregistersymbol(fpsfix)
dealloc(fpsfix)

//==============================================================================
// ADDRESS MAP (RVA from MarySkelter2.exe base; Ghidra base 0x7FF6A35D0000)
//==============================================================================
// CODE
//  +14D790   Framework_GetDeltaTime()      return g_Framework-&gt;deltaTime  (1/60)
//  +14D7A0   Framework_GetFramerate()      return 1.0f / deltaTime
//  +1391C0   GetFrameStepScale()           max(60/fps, 1.0)
//  +113130   Tween_Evaluate(tween)         {curve,from,to,time,duration,ease}
//  +10D980   UpdateFrameCounterTween()     frame += 1.0
//  +98400    UpdateTweenList_A             tween.time += GetDeltaTime()
//  +9AE60    UpdateTweenList_B             (patched by old script 281/280)
//  +A0270    UpdateTweenList_C
//  +CBA40    UpdateBustupBlinkState        blink/expression timer (VN portraits)
//  +125FC0   audio/logic tick accumulator
//  +3BCD60   FrameLimiter_Wait()           spin/Sleep to the target frame time
//  +3B1AE0   GetTargetFrameTimeMs()        switch on mode at obj+0xA0
//                                          mode 1 -&gt; 0ms = uncapped
//
// DATA
//  +136565C  g_realFrameDelta   float, real seconds per frame  (LIVE)
//  +A6CEF8   -&gt; g_Framework;  +0x128 = deltaTime (pinned 1/60), +0x120 = 1
//  +A6A3A8   -&gt; g_Graphics;   +0xC0 = measured fps, +0xA0 = fps mode
//  +700DC4   60.0f
//  +700638   0.0166666754f  (1/60 - the fixed timestep constant)
//  +6FF588   1.0f  (generic engine constant - do NOT repurpose globally)
//  +D063F8   1.0f  (frame-counter step in UpdateFrameCounterTween)
//  +7270DC   16.6666f  (target frame time in ms, 60fps mode)
//==============================================================================

</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>289</ID>
                  <Description>"Stage 2: GetFrameStepScale - remove 1.0 floor"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
//==============================================================================
// Stage 2 - GetFrameStepScale: remove the 1.0 floor
//
// MarySkelter2.exe+1391C0  GetFrameStepScale()
//    mov   rax,[g_Graphics]
//    movss xmm0,[60.0]
//    divss xmm0,[rax+0xC0]      ; 60 / measuredFps
//    maxss xmm0,[1.0]           ; &lt;-- floor: can never scale below 60fps
//    ret
//
// This is the engine's own compensation for frame-COUNT based animation.
// It works downward (30fps -&gt; 2.0) but the floor pins it at 1.0 above 60fps.
// Callers include the event/script playback cursor, UI parameter tweens and
// transition timers - i.e. the menu and 2D animation layer.
//
// The floor is replaced with a CEILING of 2.0 (same 8 bytes, in place, no cave):
//   360fps -&gt; 0.167   60fps -&gt; 1.0   30fps -&gt; 2.0 (unchanged)   fps=0 -&gt; 2.0
// The cap also makes this SAFER than stock: the original would return +inf if
// measuredFps were ever 0, this cannot.
//==============================================================================
alloc(fsconst,64,"MarySkelter2.exe")
label(c_stepMax)
registersymbol(fsconst)

fsconst:
c_stepMax:
 dd (float)2.0

"MarySkelter2.exe"+1391D7:
 minss xmm0,[c_stepMax]

[DISABLE]
"MarySkelter2.exe"+1391D7:
 db F3 0F 5F 05 A9 63 5C 00

unregistersymbol(fsconst)
dealloc(fsconst)
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>290</ID>
                  <Description>"Stage 3: 2D/Live2D animation cursor - scale by 60/fps"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
//==============================================================================
// Stage 3 - Framerate-independent 2D / Live2D animation cursor
//
// MarySkelter2.exe+12DB70  AdvanceAnimCursor(track, state, stepInFrames)
//   +12DB7E  mulss xmm2,[rdx+0C]   ; step *= track-&gt;speedMultiplier
//   +12DBF3  movss [rdx],xmm2      ; cursor += step
//
// All four callers pass a hardcoded 1.0 ("advance one frame") with no
// framerate scaling. Verified live: the cursor climbed +1.0 per RENDERED
// frame (362/sec at 360fps); with this patch it runs at 59.4/sec = 60fps.
//
// Reads neither g_Framework-&gt;deltaTime nor GetFrameStepScale.
//
// 5-byte mulss replaced by a 5-byte jmp - exact fit. Cave uses only mulss/jmp:
// no registers, no stack, no EFLAGS (a comiss at +12DB78 is consumed by a jb
// at +12DB83, straddling this site).
//
// g_animScale is held at 60/currentFps by the Lua timer below.
//==============================================================================
alloc(animfix,64,"MarySkelter2.exe")
label(g_animScale)
label(AnimStepHook)
label(anim_ret)
registersymbol(animfix)
registersymbol(g_animScale)

animfix:
g_animScale:
 dd (float)1.0

AnimStepHook:
 mulss xmm2,[rdx+0C]
 mulss xmm2,[g_animScale]
 jmp anim_ret

"MarySkelter2.exe"+12DB7E:
 jmp AnimStepHook
anim_ret:

{$lua}
if syntaxcheck then return end
if MS2_animTimer ~= nil then pcall(function() MS2_animTimer.destroy() end) end
MS2_animTimer = createTimer(nil, false)
MS2_animTimer.Interval = 50
MS2_animTimer.OnTimer = function(t)
  pcall(function()
    local b = getAddress("MarySkelter2.exe")
    local g = readQword(b + 0xA6A3A8)
    local gs = getAddress("g_animScale")
    local fps = readFloat(g + 0xC0)
    if fps and fps &gt; 1 then
      local s = 60.0 / fps
      if s &lt; 0.02 then s = 0.02 end
      if s &gt; 2.0 then s = 2.0 end
      writeFloat(gs, s)
    end
  end)
end
MS2_animTimer.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if MS2_animTimer ~= nil then
  pcall(function() MS2_animTimer.destroy() end)
  MS2_animTimer = nil
end
{$asm}

"MarySkelter2.exe"+12DB7E:
 db F3 0F 59 52 0C

unregistersymbol(g_animScale)
unregistersymbol(animfix)
dealloc(animfix)
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>293</ID>
                  <Description>"Stage 4: global UI sine phases - scale by 60/fps"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
//==============================================================================
// Stage 4 - global UI sine phases: advance per 60Hz tick, not per rendered frame
//
// FUN @ MarySkelter2.exe+109580, runs once per rendered frame:
//   +1095B1  addss xmm2,[+70052C]   ; phase A += 0.60 rad
//   +1095B9  addss xmm1,[+6FFD50]   ; phase B += 0.20 rad
//   +1095C1  addss xmm0,[+700C00]   ; phase C += 0.05 rad
//   (wrapped against pi / 2*pi, stored at +D05D58 / +D05D5C / +D05D60)
//
// Three global sine phases driving pulsing/blinking UI. Fixed radians per
// RENDERED frame, no scaling: phase B is ~1.9Hz at 60fps but ~11.5Hz at 360.
//
// Fix: repoint each operand at a scaled copy (const * 60/fps). Three in-place
// 8-byte operand rewrites - identical length, no jmp, no cave, no control flow
// or stack change. The constants themselves are shared globals and are NOT
// modified.
//==============================================================================
alloc(phasefix,64,"MarySkelter2.exe")
label(s_phaseA)
label(s_phaseB)
label(s_phaseC)
registersymbol(phasefix)
registersymbol(s_phaseA)
registersymbol(s_phaseB)
registersymbol(s_phaseC)

phasefix:
s_phaseA:
 dd (float)0.6
s_phaseB:
 dd (float)0.2
s_phaseC:
 dd (float)0.05

"MarySkelter2.exe"+1095B1:
 addss xmm2,[s_phaseA]

"MarySkelter2.exe"+1095B9:
 addss xmm1,[s_phaseB]

"MarySkelter2.exe"+1095C1:
 addss xmm0,[s_phaseC]

{$lua}
if syntaxcheck then return end
if MS2_phaseTimer ~= nil then pcall(function() MS2_phaseTimer.destroy() end) end
MS2_phaseTimer = createTimer(nil, false)
MS2_phaseTimer.Interval = 50
MS2_phaseTimer.OnTimer = function(t)
  pcall(function()
    local b = getAddress("MarySkelter2.exe")
    local g = readQword(b + 0xA6A3A8)
    local fps = readFloat(g + 0xC0)
    if fps and fps &gt; 1 then
      local s = 60.0 / fps
      if s &lt; 0.02 then s = 0.02 end
      if s &gt; 2.0 then s = 2.0 end
      writeFloat(getAddress("s_phaseA"), 0.6  * s)
      writeFloat(getAddress("s_phaseB"), 0.2  * s)
      writeFloat(getAddress("s_phaseC"), 0.05 * s)
    end
  end)
end
MS2_phaseTimer.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if MS2_phaseTimer ~= nil then
  pcall(function() MS2_phaseTimer.destroy() end)
  MS2_phaseTimer = nil
end
{$asm}

"MarySkelter2.exe"+1095B1:
 db F3 0F 58 15 73 6F 5F 00

"MarySkelter2.exe"+1095B9:
 db F3 0F 58 0D 8F 67 5F 00

"MarySkelter2.exe"+1095C1:
 db F3 0F 58 05 37 76 5F 00

unregistersymbol(s_phaseA)
unregistersymbol(s_phaseB)
unregistersymbol(s_phaseC)
unregistersymbol(phasefix)
dealloc(phasefix)
</AssemblerScript>
                </CheatEntry>
