          <ID>203</ID>
          <Description>"What is seemingly causing the resolution list oddities with ultrawide monitors (Pattern: 80 07 ? 00 38 04 ? 00 00)"</Description>
          <ShowAsHex>1</ShowAsHex>
          <VariableType>Array of byte</VariableType>
          <ByteLength>9</ByteLength>
