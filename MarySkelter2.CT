    <CheatEntry>
      <ID>294</ID>
      <Description>"Stage 5: smooth movement/turn (fractional frame index)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//==============================================================================
// Stage 5 - smooth dungeon movement/turn (remove whole-frame quantisation)
//
// MarySkelter2.exe+30E450  (a GetFrameStepScale caller - the movement curve)
//   +30E49E  movss xmm9,[rcx+64]        ; t = elapsed, in frames
//   +30E4A4  call GetFrameStepScale
//   +30E4B8  mulss xmm9,[1.0]
//   +30E4C1  cvttss2si edx,xmm9         ; n = (int)t   &lt;-- TRUNCATED
//   ...loop sums acceleration over n whole frames into xmm6/xmm7/xmm8...
//   +30E5BF  xorps    xmm2,xmm2
//   +30E5C2  cvtsi2ss xmm2,edx          ; nf = (float)n   &lt;-- back to float
//   +30E5CC  mulss xmm0,[rdi+40] / subss xmm0,xmm6 / addss [r15] ...
//
// Displacement = nf*velocity - accumulatedAccel. Because nf comes from the
// TRUNCATED frame index, the position only moves when t crosses an integer.
// With Stage 2 the step is 60/fps (0.167 at 360fps), so that is once every 6
// rendered frames - correct speed, but 60Hz motion. Before Stage 2 the step
// was 1.0/frame so it moved every frame (smooth, 6x too fast).
//
// Fix: feed the FRACTIONAL t into the dominant velocity term instead of the
// truncated integer. 7 bytes replaced by 7 bytes, in place - no cave, no jump,
// no control flow or stack change. The acceleration sum still uses whole
// frames; that term is the smaller correction.
//==============================================================================
"MarySkelter2.exe"+30E5BF:
 movss xmm2,[rdi+64]
 nop
 nop

[DISABLE]
"MarySkelter2.exe"+30E5BF:
 db 0F 57 D2 F3 0F 2A D2
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>295</ID>
      <Description>"Stage 9: yaw interpolation + per-frame transform rebuild"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//==============================================================================
// Stage 9 - camera yaw interpolation + per-frame transform rebuild
//
// THE MISSING PIECE: FUN @ MarySkelter2.exe+BCA00 is the camera transform
// builder. It reads the euler yaw at camObj+0x434, converts it to the
// quaternion at camObj+0x090 and the view matrix at camObj+0x290 - which is
// what the renderer actually draws from.
//
// Measured: that builder only runs ~once per 3.2 rendered frames (218 quaternion
// changes over 696 frames). So interpolating +0x434 every frame achieved
// nothing - the conversion to the matrix the renderer uses happened at ~60Hz
// and simply resampled the staircase. The euler field is not vestigial, it is
// just read too rarely.
//
// Fix: interpolate +0x434 as before, then CALL the builder every frame so the
// quaternion and matrix are regenerated from the interpolated angle.
//
//   if target changed:  prev = last; last = target; tick = frameCounter
//   alpha = clamp((frameCounter - tick) / holdFrames, 0, 1)
//   +0x434 = prev + wrap(last - prev) * alpha
//   rebuild(camObj)
//
// The call uses sub rsp,28 for 16-byte alignment plus 0x20 shadow space, per
// the x64 ABI. The builder is gated on camObj+0x414 == 0 (verified 0) and does
// not call back into SetCameraYaw, so no recursion.
//
// Self-contained. Code before data. No dealloc on disable.
//==============================================================================
alloc(msCamY,4096,"MarySkelter2.exe")
label(SmYaw)
label(y_nohi)
label(y_nolo)
label(y_write)
label(y_ret)
label(g_hold)
label(c_one)
label(c_zero)
label(c_pi)
label(c_npi)
label(c_2pi)
label(yprev)
label(ylast)
label(ytick)
registersymbol(msCamY)
registersymbol(g_hold)
registersymbol(ylast)
registersymbol(yprev)
registersymbol(ytick)

msCamY:
SmYaw:
 comiss xmm0,[ylast]
 je y_nohi
 movss xmm1,[ylast]
 movss [yprev],xmm1
 movss [ylast],xmm0
 mov eax,[MarySkelter2.exe+D05428]
 mov [ytick],eax
y_nohi:
 mov eax,[MarySkelter2.exe+D05428]
 sub eax,[ytick]
 cvtsi2ss xmm2,eax
 divss xmm2,[g_hold]
 minss xmm2,[c_one]
 maxss xmm2,[c_zero]
 movss xmm3,[ylast]
 subss xmm3,[yprev]
 comiss xmm3,[c_pi]
 jbe y_nolo
 subss xmm3,[c_2pi]
y_nolo:
 comiss xmm3,[c_npi]
 jae y_write
 addss xmm3,[c_2pi]
y_write:
 mulss xmm3,xmm2
 addss xmm3,[yprev]
 mov rax,[MarySkelter2.exe+A6CEB0]
 test rax,rax
 je y_ret
 mov rcx,[rax+40]
 test rcx,rcx
 je y_ret
 movss [rcx+00000434],xmm3
 sub rsp,28
 call "MarySkelter2.exe"+BCA00
 add rsp,28
y_ret:
 ret

g_hold:
 dd (float)6.0
c_one:
 dd (float)1.0
c_zero:
 dd (float)0.0
c_pi:
 dd (float)3.14159265
c_npi:
 dd (float)-3.14159265
c_2pi:
 dd (float)6.28318531
yprev:
 dd (float)0.0
ylast:
 dd (float)0.0
ytick:
 dd 0

"MarySkelter2.exe"+BD760:
 jmp SmYaw

{$lua}
if syntaxcheck then return end
if MS2_holdTimer ~= nil then pcall(function() MS2_holdTimer.destroy() end) end
MS2_lastF=nil MS2_lastT=nil
MS2_holdTimer = createTimer(nil,false)
MS2_holdTimer.Interval = 100
MS2_holdTimer.OnTimer = function(t)
  pcall(function()
    local b=getAddress("MarySkelter2.exe")
    local f=readInteger(b+0xD05428)
    local now=getTickCount()
    if MS2_lastF and f and f&gt;MS2_lastF and now&gt;MS2_lastT then
      local hold=((f-MS2_lastF)*1000/(now-MS2_lastT))/60.0
      if hold&lt;1.0 then hold=1.0 end
      if hold&gt;30.0 then hold=30.0 end
      local cur=readFloat(getAddress("g_hold")) or hold
      writeFloat(getAddress("g_hold"), cur+(hold-cur)*0.3)
    end
    MS2_lastF=f MS2_lastT=now
  end)
end
MS2_holdTimer.Enabled=true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if MS2_holdTimer ~= nil then pcall(function() MS2_holdTimer.destroy() end) MS2_holdTimer=nil end
{$asm}

"MarySkelter2.exe"+BD760:
 db 48 8B 05 49 F7 9A 00 48 8B 48 40 F3 0F 11 81 34 04 00 00 C3
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>296</ID>
      <Description>"DIAGNOSTIC: camera spin test (not a fix)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//==============================================================================
// DIAGNOSTIC ONLY - "does the scene actually re-render every frame?"
//
// Drives the camera yaw directly from the frame counter, so it spins at a
// constant rate with a NEW value on every single rendered frame, then forces
// the transform builder (+BCA00) so the view matrix is rebuilt each frame too.
//
// 0.02 rad/frame at ~350fps = ~7 rad/s (about 1.1 rotations per second).
//   * If the scene renders every frame  -&gt; ~350 distinct positions/sec, smooth
//   * If the scene renders at ~60Hz     -&gt; 60 steps of 6.7 deg each, obviously chunky
//
// This is not a fix. It makes the camera spin on its own.
//==============================================================================
alloc(msSpin,1024,"MarySkelter2.exe")
label(SpinTest)
label(s_ret)
label(sp_k)
label(sp_pi)
registersymbol(msSpin)
registersymbol(sp_k)

msSpin:
SpinTest:
 mov eax,[MarySkelter2.exe+D05428]
 and eax,000003FF
 cvtsi2ss xmm3,eax
 mulss xmm3,[sp_k]
 subss xmm3,[sp_pi]
 mov rax,[MarySkelter2.exe+A6CEB0]
 test rax,rax
 je s_ret
 mov rcx,[rax+40]
 test rcx,rcx
 je s_ret
 movss [rcx+00000434],xmm3
 sub rsp,28
 call "MarySkelter2.exe"+BCA00
 add rsp,28
s_ret:
 ret

sp_k:
 dd (float)0.02
sp_pi:
 dd (float)3.14159265

"MarySkelter2.exe"+BD760:
 jmp SpinTest

[DISABLE]
"MarySkelter2.exe"+BD760:
 db 48 8B 05 49 F7 9A 00 48 8B 48 40 F3 0F 11 81 34 04 00 00 C3
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>297</ID>
      <Description>"DIAGNOSTIC A/B: spin, per-frame vs 60Hz (sp2_div)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(spinab,4096,"MarySkelter2.exe")
label(Spin2)
label(sp2_ret)
label(sp2_k)
label(sp2_pi)
label(sp2_div)
registersymbol(spinab)
registersymbol(sp2_div)
registersymbol(sp2_k)

spinab:
Spin2:
 mov eax,[MarySkelter2.exe+D05428]
 and eax,000003FF
 xor edx,edx
 div dword ptr [sp2_div]
 mul dword ptr [sp2_div]
 cvtsi2ss xmm3,eax
 mulss xmm3,[sp2_k]
 subss xmm3,[sp2_pi]
 mov rax,[MarySkelter2.exe+A6CEB0]
 test rax,rax
 je sp2_ret
 mov rcx,[rax+40]
 test rcx,rcx
 je sp2_ret
 movss [rcx+00000434],xmm3
 sub rsp,28
 call "MarySkelter2.exe"+BCA00
 add rsp,28
sp2_ret:
 ret

sp2_k:
 dd (float)0.02
sp2_pi:
 dd (float)3.14159265
sp2_div:
 dd 00000001

"MarySkelter2.exe"+BD760:
 jmp Spin2

[DISABLE]
"MarySkelter2.exe"+BD760:
 db 48 8B 05 49 F7 9A 00 48 8B 48 40 F3 0F 11 81 34 04 00 00 C3

unregistersymbol(sp2_k)
unregistersymbol(sp2_div)
unregistersymbol(spinab)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
