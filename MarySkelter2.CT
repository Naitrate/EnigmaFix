        <CheatEntry>
          <ID>202</ID>
          <Description>"Adjust UI elements"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
// Vertical Res
alloc(newmem2,2048,"MarySkelter2.exe"+38A51D) 
label(returnhere2)
label(originalcode2)
label(exit2)

newmem2: //this is allocated memory, you have read,write,execute access
//place your code here
mov ecx,(int)1080

originalcode2:
//mov ecx,[rcx+04]
mov [rax+04],ecx

// signature: 8b 49 ? 89 48 ? 48 8b 44 24 ? 48 83 c4

exit2:
jmp returnhere2

"MarySkelter2.exe"+38A51D:
jmp newmem2
nop
returnhere2:



//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048,"MarySkelter2.exe"+38A510) 
label(returnhere)
label(originalcode)
label(exit)

newmem: //this is allocated memory, you have read,write,execute access
//place your code here
mov ecx,(int)2580

originalcode:
//mov ecx,[rcx]
mov [rax],ecx
mov rax,[rsp+28]

// signature: 8b 09 89 08 48 8b 44 24 ? 48 8b 0c 24 8b 49 ? 89 48 ? 48 8b 44 24 ? 48 83 c4

exit:
jmp returnhere

"MarySkelter2.exe"+38A510:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem2)
"MarySkelter2.exe"+38A51D:
mov ecx,[rcx+04]
mov [rax+04],ecx
//Alt: db 8B 49 04 89 48 04
dealloc(newmem)
"MarySkelter2.exe"+38A510:
mov ecx,[rcx]
mov [rax],ecx
mov rax,[rsp+28]
//Alt: db 8B 09 89 08 48 8B 44 24 28
</AssemblerScript>
