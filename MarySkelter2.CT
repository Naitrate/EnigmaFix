        <CheatEntry>
          <ID>62</ID>
          <Description>"Camera"</Description>
          <Options moManualExpandCollapse="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>285</ID>
              <Description>"Patch nearZ Plane"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Mary Skelter 2 - near-clip plane override

  WHY:
  The camera's near-clip plane is set once at camera init to the engine's
  shared 1.0f constant (DAT_7ff6a3ccf588). At 16:9 the near plane's half-width
  is  near * tan(fov/2) * aspect , so at FOV 150 it is ~13 units across and
  slices open any geometry beside you - the pink/white "shards" bug.

  You cannot edit the 1.0f constant itself: it is the generic 1.0 used all over
  the binary. So we hook the setter instead.

  WHAT:
  MarySkelter2.exe+BD72B  is  movss [rcx+468],xmm0  inside the near-clip setter
  (one caller: the camera initialiser). We replace XMM0 with our own value.
  +0x468 is the authoritative source - the engine copies it into the camera's
  _nearZ (+0x288) every frame.

  TUNING:
  After enabling, add "ms2_nearz" as a Float entry in your cheat table to
  change the near plane live. 0.05 is a good default. Lower widens your usable
  FOV further; below ~0.02 you start risking z-fighting on distant geometry
  (far plane is 2048).

  NOTE:
  The setter only runs when the camera initialises, so the ASM hook alone takes
  effect on the next room/floor/battle transition. The {$lua} //block below also
  //writes the value straight into the live camera so it applies immediately.
//}

[ENABLE]

globalalloc(ms2_nearz,4)
alloc(newmem,256,MarySkelter2.exe+BD72B)
label(return)

ms2_nearz:
  dd (float)0.05

newmem:
  movss xmm0,[ms2_nearz]
  movss [rcx+00000468],xmm0
  jmp return

MarySkelter2.exe+BD72B:
  jmp newmem
  nop 3
return:

{$lua}
if syntaxcheck then return end
-- apply to the already-running camera as well, so you see it without
-- having to change rooms:  [[MarySkelter2.exe+A6CEB0]+40]+468
local ok, err = pcall(function()
  local a   = readPointer(getAddress("MarySkelter2.exe") + 0xA6CEB0)
  local cam = a and a ~= 0 and readPointer(a + 0x40) or nil
  if cam and cam ~= 0 then
    writeFloat(cam + 0x468, readFloat(getAddress("ms2_nearz")))
  end
end)
if not ok then print("ms2 nearclip: live apply skipped ("..tostring(err)..")") end
{$asm}


[DISABLE]

MarySkelter2.exe+BD72B:
  db F3 0F 11 81 68 04 00 00

{$lua}
if syntaxcheck then return end
pcall(function()
  local a   = readPointer(getAddress("MarySkelter2.exe") + 0xA6CEB0)
  local cam = a and a ~= 0 and readPointer(a + 0x40) or nil
  if cam and cam ~= 0 then writeFloat(cam + 0x468, 1.0) end   -- stock value
end)
{$asm}

unregistersymbol(ms2_nearz)
dealloc(newmem)

{
// ORIGINAL CODE - INJECTION POINT: MarySkelter2.exe+BD72B

MarySkelter2.exe+BD720: 48 8B 05 89 F7 9A 00  -  mov rax,[MarySkelter2.exe+A6CEB0]
MarySkelter2.exe+BD727: 48 8B 48 40           -  mov rcx,[rax+40]
MarySkelter2.exe+BD72B: F3 0F 11 81 68 04 00 00  -  movss [rcx+00000468],xmm0
MarySkelter2.exe+BD733: C3                    -  ret
}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
