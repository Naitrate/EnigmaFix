                      <ID>288</ID>
                      <Description>"Framerate-Independent Animation Fix v2 (variable timestep)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
//==============================================================================
// Mary Skelter 2 - Framerate-Independent Animation Fix v2
// 1) Force the engine's own variable-timestep mode ON (g_Framework+0x120 = 0)
//    -&gt; g_Framework-&gt;deltaTime becomes a real per-frame delta, written by the
//       engine. Fixes the getter AND every inlined reader of the field.
// 2) Publish g_frameScale = deltaTime*60 ("frames elapsed this update")
// 3) GetFrameStepScale: drop the max(...,1.0) floor that blocks &gt;60fps
// 4) UpdateFrameCounterTween: step by g_frameScale instead of a literal 1.0
//==============================================================================
alloc(fpsfix,1024,"MarySkelter2.exe")
label(g_frameScale)
label(c_scaleMin)
label(c_scaleMax)
label(ForceVarTimestep)
label(vt_ret)
label(GetDeltaTime_new)
label(GetFrameStep_new)
registersymbol(fpsfix)
registersymbol(g_frameScale)

fpsfix:
g_frameScale:
 dd (float)1.0
c_scaleMin:
 dd (float)0.02
c_scaleMax:
 dd (float)2.0

ForceVarTimestep:
 mov rax,[rsp+00000080]
 push rcx
 xor ecx,ecx
 mov [rax+00000120],ecx
 pop rcx
 jmp vt_ret

"MarySkelter2.exe"+424FD9:
 jmp ForceVarTimestep
 nop 3
vt_ret:

GetDeltaTime_new:
 mov rax,[MarySkelter2.exe+A6CEF8]
 movss xmm0,[MarySkelter2.exe+700DC4]
 mulss xmm0,[rax+00000128]
 maxss xmm0,[c_scaleMin]
 minss xmm0,[c_scaleMax]
 movss [g_frameScale],xmm0
 movss xmm0,[rax+00000128]
 ret

"MarySkelter2.exe"+14D790:
 jmp GetDeltaTime_new

GetFrameStep_new:
 movss xmm0,[g_frameScale]
 ret

"MarySkelter2.exe"+1391C0:
 jmp GetFrameStep_new

"MarySkelter2.exe"+10D9A5:
 movss xmm6,[g_frameScale]

"MarySkelter2.exe"+10D9B5:
 addss xmm4,[g_frameScale]

[DISABLE]
"MarySkelter2.exe"+424FD9:
 db 48 8B 84 24 80 00 00 00

"MarySkelter2.exe"+14D790:
 db 48 8B 05 61 F7 91 00 F3 0F 10 80 28 01 00 00 C3

"MarySkelter2.exe"+1391C0:
 db 48 8B 05 E1 11 93 00 F3 0F 10 05 F5 7B 5C 00 F3 0F 5E 80 C0 00 00 00 F3 0F 5F 05 A9 63 5C 00 C3

"MarySkelter2.exe"+10D9A5:
 db F3 0F 10 35 DB 1B 5F 00

"MarySkelter2.exe"+10D9B5:
 db F3 0F 58 25 3B 8A BF 00

unregistersymbol(g_frameScale)
unregistersymbol(fpsfix)
dealloc(fpsfix)
</AssemblerScript>
